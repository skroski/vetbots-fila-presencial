# Todas opcionais. Copie para ".env" só se precisar mudar algo.
# (Sem Docker, defina na hora de iniciar:  PORT=3001 ADMIN_PIN=1234 npm start)

# Porta do sistema (padrão 3000)
PORT=3000

# PIN para proteger a tela de Ajustes (cores, logo, vídeos, salas). Vazio = sem PIN.
ADMIN_PIN=

# Pasta dos dados (banco + uploads). Padrão: ./data
# DATA_DIR=./data

# Limite por vídeo enviado, em MB (padrão 2048)
# MAX_VIDEO_MB=2048

# Fuso horário (Docker). A numeração das senhas reinicia à meia-noite deste fuso.
TZ=America/Sao_Paulo

# --- Só para quem MANTÉM o guia (docs/instalacao.html): gerar a narração em MP3 com o Fish Audio ---
# Não é necessário para usar o sistema: os MP3 já vêm no pacote. Comando: npm run help:audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
