{
  "name": "vetbots-fila-presencial",
  "version": "2.0.0",
  "description": "Sistema de fila presencial para clínicas veterinárias: recepção, TV com vídeos, chamador de consultório, totem e métricas. Node + SQLite embutido, 100% local.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config web/vite.config.ts\"",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test server/test/fila.test.js server/test/pin.test.js",
    "sync-skill": "node scripts/sync-skill.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
